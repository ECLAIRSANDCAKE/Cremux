<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/tx_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/partial_header" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:paddingTop="4dp">
            <TextView android:id="@+id/chip_all" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="All" android:textColor="@color/chip_text" android:textSize="13sp" />
            <TextView android:id="@+id/chip_development" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Development" android:textColor="@color/chip_text" android:textSize="13sp" />
            <TextView android:id="@+id/chip_system" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="System" android:textColor="@color/chip_text" android:textSize="13sp" />
            <TextView android:id="@+id/chip_network" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Network" android:textColor="@color/chip_text" android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp" />

    <TextView
        android:id="@+id/btn_new_template"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:background="@drawable/ripple_card"
        android:clickable="true"
        android:drawableStart="@drawable/ic_add"
        android:drawablePadding="10dp"
        android:drawableTint="?attr/tx_text"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="110dp"
        android:paddingEnd="110dp"
        android:text="New Template"
        android:textColor="?attr/tx_text"
        android:textSize="15sp" />
</LinearLayout>
