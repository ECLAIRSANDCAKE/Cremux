<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/tx_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/partial_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="10dp">
        <TextView android:id="@+id/tab_search" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="Search" android:textColor="@color/chip_text" android:textSize="13sp" />
        <TextView android:id="@+id/tab_installed" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="Installed" android:textColor="@color/chip_text" android:textSize="13sp" />
        <TextView android:id="@+id/tab_updates" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="Updates" android:textColor="@color/chip_text" android:textSize="13sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/package_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_search"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:drawableTint="?attr/tx_text_2"
        android:hint="Search packages…"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="?attr/tx_text"
        android:textColorHint="?attr/tx_text_2"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/package_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:textColor="?attr/tx_text_2"
        android:textSize="12sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp" />

    <LinearLayout
        android:id="@+id/update_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_margin="12dp"
        android:background="@drawable/bg_bottom_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_check_circle"
            android:tint="?attr/tx_green" />

        <TextView
            android:id="@+id/update_bar_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textColor="?attr/tx_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_update_all"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_tonal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Update All"
            android:textColor="?attr/tx_text"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
