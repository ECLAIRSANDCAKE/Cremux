<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <ImageView
        android:id="@+id/pkg_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icon_tile"
        android:contentDescription="@null"
        android:padding="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pkg_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/tx_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pkg_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/tx_text_2"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/pkg_action"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_btn_tonal"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="76dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="?attr/tx_text"
        android:textSize="13sp" />
</LinearLayout>
